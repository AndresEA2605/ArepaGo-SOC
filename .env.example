# Copiar a .env para apuntar los servicios a PostgreSQL.
# Local: DB_HOST=postgres, iniciar Compose con --profile local.
# Amazon RDS: usar el endpoint DNS de la instancia y el override docker-compose.rds.yml.
APP_ENV=local
# UID/GID del proceso no-root. start_local.sh exporta los de tu usuario para
# que pueda leer los secretos locales con permisos 600. En producción usa
# 10001 (valor por defecto) o el UID que corresponda a tus secretos.
APP_UID=10001
APP_GID=10001
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arepagosoc
DB_USER=arepagosoc_app
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_POOL_MIN_SIZE=1
# 12 procesos con pool (8 réplicas de negocio + 4 servicios) × 10 = 120 conexiones.
# Mantener réplicas × DB_POOL_MAX_SIZE por debajo de max_connections menos la reserva.
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_POOL_MAX_IDLE_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=30000
SLOW_QUERY_MS=500
DB_CONNECT_TIMEOUT=5
DB_STARTUP_TIMEOUT_SECONDS=45
METRICS_SAMPLE_SECONDS=15
# Retención de datos de observabilidad. Los incidentes abiertos nunca se purgan.
LOG_RETENTION_DAYS=30
MEASUREMENT_RETENTION_DAYS=30
INCIDENT_RETENTION_DAYS=180
# Una réplica que deja de publicar no sigue sumando tráfico al agregado.
MEASUREMENT_FRESH_SECONDS=120
INCIDENT_RECOVERY_SAMPLES=3
# Minutos sin nuevas muestras degradadas tras los cuales un incidente sin
# tráfico se cierra por inactividad. 0 lo desactiva.
INCIDENT_INACTIVITY_MINUTES=30
# Cadencia con la que Incident evalúa el último agregado por servicio.
INCIDENT_EVALUATE_SECONDS=15
UPSTREAM_TIMEOUT_SECONDS=4
ADMIN_EMAIL=admin@arepago.local
SESSION_HOURS=12
# Local usa HTTP. En producción con HTTPS debe ser true; el gateway se niega
# a arrancar con APP_ENV=production y esta variable desactivada.
AUTH_COOKIE_SECURE=false
# La identidad interna se firma con secrets/internal_auth_secret.txt
# (start_local.sh lo genera si falta); no se configura por variable en local.
