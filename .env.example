# Copiar a .env para apuntar los servicios a PostgreSQL.
# Local: DB_HOST=postgres, iniciar Compose con --profile local.
# Amazon RDS: usar el endpoint DNS de la instancia y el override docker-compose.rds.yml.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arepagosoc
DB_USER=arepagosoc_app
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT=5
DB_STARTUP_TIMEOUT_SECONDS=45
